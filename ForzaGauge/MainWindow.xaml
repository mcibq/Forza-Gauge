<Window x:Class="ForzaGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForzaGauge"
        xmlns:views="clr-namespace:ForzaGauge.Views"
        xmlns:vms="clr-namespace:ForzaGauge.ViewModels"
        mc:Ignorable="d"
        Title="Forza Gauge" MinHeight="1000" MinWidth="1700" WindowState="Maximized">
    <Grid Background="#FF1B1616">
        <views:DashboardView DataContext="{Binding CurrentViewModel}"></views:DashboardView>
    </Grid>
</Window>
